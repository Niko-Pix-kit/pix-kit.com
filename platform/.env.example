# Load from server-only environment or secret manager. Never publish values.
PORT=4173
PIXKIT_BIND=127.0.0.1
PIXKIT_ORIGIN=http://127.0.0.1:4173
# Set mariadb for direct Google sign-in. Leave blank for the legacy backend.
PIXKIT_AUTH_BACKEND=
PIXKIT_DB_NAME=
PIXKIT_DB_USER=
PIXKIT_DB_PASSWORD=
PIXKIT_DB_SOCKET=
PIXKIT_GOOGLE_CLIENT_ID=
PIXKIT_GOOGLE_CLIENT_SECRET=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
PIXKIT_AUTH_GOOGLE=0
PIXKIT_AUTH_APPLE=0
PIXKIT_AUTH_EMAIL=0
OPENAI_API_KEY=
# Optional alternative to TCP. Use a private, runtime-owned directory.
PIXKIT_SOCKET=
